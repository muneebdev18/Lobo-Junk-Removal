# Resend (https://resend.com) — used by the /api/contact route to email
# form submissions. Copy this file to .env.local and fill in your key.

RESEND_API_KEY=re_3bv5f9WX_3zMUM9q5YkCTuEUyhbemu1iw

# Where quote requests are sent. Defaults to lobojunkremover@gmail.com.
CONTACT_TO_EMAIL=lobojunkremover@gmail.com

# Optional. Defaults to Resend's shared test sender
# ("LOBO Junk Removal <onboarding@resend.dev>"), which can only deliver
# to the email address that owns the Resend account. To send from your
# own address, verify a domain in Resend and set e.g.:
# CONTACT_FROM_EMAIL="LOBO Junk Removal <quotes@yourdomain.com>"
